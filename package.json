{
  "name": "@geastack/ffi",
  "version": "0.1.0",
  "description": "Call C shared libraries from Node, with GeaStack native headers. Windows, Linux, and macOS hosts are native; iOS cross-compiles; other platform bridges are in-process simulations until verified.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetfiskindal/geastack-ffi.git"
  },
  "bugs": {
    "url": "https://github.com/mehmetfiskindal/geastack-ffi/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js",
      "default": "./dist/library.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./apple": {
      "types": "./dist/apple/index.d.ts",
      "import": "./dist/apple/index.js",
      "default": "./dist/apple/index.js"
    },
    "./android": {
      "types": "./dist/android/index.d.ts",
      "import": "./dist/android/index.js",
      "default": "./dist/android/index.js"
    },
    "./windows": {
      "types": "./dist/windows/index.d.ts",
      "import": "./dist/windows/index.js",
      "default": "./dist/windows/index.js"
    },
    "./linux": {
      "types": "./dist/linux/index.d.ts",
      "import": "./dist/linux/index.js",
      "default": "./dist/linux/index.js"
    },
    "./sailfishos": {
      "types": "./dist/sailfishos/index.d.ts",
      "import": "./dist/sailfishos/index.js",
      "default": "./dist/sailfishos/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded/index.d.ts",
      "import": "./dist/embedded/index.js",
      "default": "./dist/embedded/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js",
      "default": "./dist/codegen/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js"
    },
    "./include/*": "./include/*",
    "./native/*": "./src/native/*",
    "./gea-plugin.json": "./gea-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "include/**/*.h",
    "src/native/**/*.cpp",
    "src/native/**/*.mm",
    "src/native/**/*.h",
    "src/native/CMakeLists.txt",
    "gea-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs test/mock/*.test.mjs test/native/*.test.mjs",
    "test:mock": "node --test test/*.test.mjs test/mock/*.test.mjs",
    "test:native": "node --test test/native/*.test.mjs",
    "test:apple-native": "node scripts/test-apple-native.mjs",
    "test:ios": "node scripts/build-ios-native.mjs",
    "test:jni-native": "node scripts/test-jni-native.mjs",
    "test:android-native": "node scripts/build-android-native.mjs",
    "test:embedded-native": "node scripts/test-embedded-native.mjs",
    "test:loader": "node scripts/test-cpp-loader.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:dbus-native": "node scripts/test-dbus-native.mjs",
    "demo:windows": "node demos/windows-ffi/demo.mjs",
    "demo:sailfishos": "sh demos/sailfishos-ffi/build.sh",
    "test:codegen-native": "node scripts/test-codegen-native.mjs",
    "build:dbus-host": "node scripts/build-dbus-host-lib.mjs",
    "test:dbus-ts-native": "node scripts/test-dbus-ts-native.mjs",
    "test:ios-sim": "node scripts/test-ios-simulator.mjs",
    "test:ffi-native": "node scripts/test-ffi-native.mjs",
    "test:windows-native": "node scripts/test-windows-native.mjs",
    "test:windows-wine": "node scripts/test-windows-wine.mjs",
    "test:dconf-native": "node scripts/test-dconf-native.mjs"
  },
  "peerDependencies": {
    "@geastack/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@geastack/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
