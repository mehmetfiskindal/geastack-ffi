{
  "name": "@geastack/ffi",
  "version": "0.1.0",
  "description": "GeaStack FFI & Native Interop Plugin",
  "compilerPlugin": "dist/plugin/index.js",
  "targets": {
    "ios": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_apple.mm"
      ],
      "include_dirs": [
        "include"
      ],
      "frameworks": [
        "Foundation"
      ]
    },
    "macos": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_apple.mm"
      ],
      "include_dirs": [
        "include"
      ],
      "frameworks": [
        "Foundation"
      ]
    },
    "android": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_android.cpp"
      ],
      "include_dirs": [
        "include"
      ]
    },
    "esp32": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_embedded.cpp"
      ],
      "include_dirs": [
        "include"
      ]
    },
    "rp2350": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_embedded.cpp"
      ],
      "include_dirs": [
        "include"
      ]
    },
    "linux": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_linux.cpp"
      ],
      "include_dirs": [
        "include"
      ],
      "libraries": [
        "dl",
        "pthread"
      ]
    },
    "sailfishos": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_linux.cpp",
        "src/native/gea_ffi_sailfishos.cpp"
      ],
      "include_dirs": [
        "include"
      ],
      "libraries": [
        "dl",
        "pthread",
        "dbus-1",
        "dconf",
        "ngf0"
      ],
      "pkg_config": [
        "sailfishapp",
        "dbus-1",
        "dconf",
        "ngf0",
        "keepalive"
      ]
    },
    "windows": {
      "cpp_sources": [
        "src/native/gea_ffi_core.cpp",
        "src/native/gea_ffi_windows.cpp"
      ],
      "include_dirs": [
        "include"
      ],
      "libraries": [
        "ole32",
        "advapi32",
        "user32"
      ]
    }
  }
}
