{
  "name": "gea-sailfishos-ffi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "vite --config vite.web.config.ts",
    "test": "node --experimental-strip-types --test test/probe.test.ts"
  },
  "dependencies": {
    "@geastack/core": "^0.1.40",
    "@geastack/ffi": "file:../..",
    "@geastack/linux": "^0.1.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "gea": {
    "id": "sailfishos-ffi",
    "name": "Sailfish FFI",
    "entry": "src/index.tsx",
    "icons": {
      "512": "assets/icon.png"
    },
    "sailfish": {
      "organizationName": "com.geastack",
      "applicationName": "harbour_geaffi",
      "permissions": ["Internet", "Audio", "Notifications"],
      "devicePixelRatio": 2
    },
    "targets": {
      "web": false,
      "linux": true,
      "sailfishos": true,
      "esp32": false,
      "rp2350": false,
      "geaos": false,
      "macos": false,
      "ios": false,
      "android": false,
      "windows": false
    }
  },
  "license": "Apache-2.0"
}
